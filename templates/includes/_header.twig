<header>
    <div id="mobileNavTop">
        <img id="logo" src="{{ asset('css/src/icons/fppp-logo.svg', 'profilepage') }}" alt="Profile Page Logo"/>

        {% for menuItem in menuManager.items %}
            {% if menuItem.label == 'Log out' %}
                <div>
                    <a href="{{ menuItem.hrefPath }}">
                        {% if menuItem.iconAssetPath %}
                            <span class="navicon">
                                <img src="{{ asset(menuItem.iconAssetPath, 'profilepage') }}" alt="{{ menuItem.label|trans }} Icon"/>
                            </span>
                        {% endif %}
                        <span class="navlabel">{{ menuItem.label|trans }}</span>
                    </a>
                </div>
            {% endif %}
        {% endfor %}
    </div>


    <hr class="divider">


    <div id="mobileNavBottom">
        {% for menuItem in menuManager.items %}
            {% if menuItem.label != 'Log out' %}
                <div>
                    <a href="{{ menuItem.hrefPath }}">
                        {% if menuItem.iconAssetPath %}
                            <span class="navicon">
                                <img src="{{ asset(menuItem.iconAssetPath, 'profilepage') }}" alt="{{ menuItem.label|trans }} Icon"/>
                            </span>
                        {% endif %}
                        <span class="navlabel">{{ menuItem.label|trans }}</span>
                    </a>
                </div>
            {% endif %}
        {% endfor %}
    </div>

    {# <label for="nav-toggle" class="nav-toggle-label">
        <span></span>
    </label> #}
</header>
